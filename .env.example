# AgyCodeUI Configuration
PORT=3080

# Per massima sicurezza su VPS usa HOST=127.0.0.1 (raggiungibile via reverse proxy o Tailscale).
# Se imposti HOST=0.0.0.0, l'impostazione di AUTH_PIN è OBBLIGATORIA (il server non si avvia senza PIN).
HOST=127.0.0.1

# PIN/Password di sicurezza per l'accesso (OBBLIGATORIO se HOST=0.0.0.0)
AUTH_PIN=

# Cartella di lavoro iniziale per AGY CLI (es. /home/utente/progetti o lascia vuoto per la cartella corrente)
WORKSPACE_DIR=

# Comando CLI da eseguire (default: agy)
CLI_COMMAND=agy

# Parametri aggiuntivi per il comando agy
CLI_ARGS=
